# MulTiCheat Pro v2.0 — Environment Variables
MULTICHEAT_DEBUG=false
MULTICHEAT_LOG_LEVEL=INFO
MULTICHEAT_HOST=0.0.0.0
MULTICHEAT_PORT=8000
MULTICHEAT_WORKERS=4

# Database & Celery
DATABASE_URL=sqlite+aiosqlite:///multicheat_pro.db
# Production TimescaleDB example: postgresql+asyncpg://multicheat:password@localhost:5432/multicheat
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0

# Storage
MULTICHEAT_UPLOAD_DIR=uploads
MULTICHEAT_EVIDENCE_DIR=evidence
MULTICHEAT_MAX_UPLOAD_SIZE_MB=2048

# Security
JWT_SECRET=super-secret-jwt-key-for-multicheat-pro-2026
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
